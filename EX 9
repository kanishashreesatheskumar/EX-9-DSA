def traverse(self):
        res = []
        def _inorder(n):
            if n:
                _inorder(n.left)
                res.append((n.enrollment_id, n.student_name, n.course_name))
                _inorder(n.right)
        _inorder(self.root)
        return res

    def count(self):
        return len(self.traverse())

def display_current(avl):
    print("\n" + "=" * 50)
    print(f"Total Enrollments: {avl.count()}")
    records = avl.traverse()
    print("Current Records (Sorted by Enrollment ID):")
    if not records:
        print("  [No enrollments found]")
    else:
        for r in records:
            print(f"  ID: {r[0]} | Student: {r[1]} | Course: {r[2]}")
    print("=" * 50)

def main():
    avl = AVLTree()
    while True:
        display_current(avl)
        print("\nMenu:")
        print("1. Insert an enrollment record")
        print("2. Delete a record by enrollment ID")
        print("3. Search for a student enrollment (by ID or Name)")
        print("4. Traverse all enrollment records (sorted by ID)")
        print("5. Count total enrollments")
        print("6. Exit")
       
        choice = input("Enter choice (1-6): ").strip()
       
        if choice == '1':
            try:
                eid = int(input("Enter Enrollment ID (integer): "))
                sname = input("Enter Student Name: ").strip()
                cname = input("Enter Course Name: ").strip()
                avl.insert(eid, sname, cname)
                print("-> Record inserted successfully.")
            except ValueError:
                print("-> Invalid ID format.")
        elif choice == '2':
            try:
                eid = int(input("Enter Enrollment ID to delete: "))
                avl.delete(eid)
                print("-> Delete operation executed.")
            except ValueError:
                print("-> Invalid ID format.")
        elif choice == '3':
            stype = input("Search by (1) ID or (2) Name? ").strip()
            if stype == '1':
                try:
                    eid = int(input("Enter Enrollment ID: "))
                    res = avl.search_by_id(eid)
                    if res:
                        print(f"-> Found: ID={res.enrollment_id}, Student={res.student_name}, Course={res.course_name}")
                    else:
                        print("-> Not found.")
                except ValueError:
                    print("-> Invalid ID format.")
            else:
                sname = input("Enter Student Name: ").strip()
                res = avl.search_by_name(sname)
                if res:
                    print(f"-> Found {len(res)} match(es):")
                    for r in res:
                        print(f"   ID={r.enrollment_id}, Student={r.student_name}, Course={r.course_name}")
                else:
                    print("-> Not found.")
        elif choice == '4':
            records = avl.traverse()
            print("Sorted Traversal Sequence:", records)
        elif choice == '5':
            print(f"Total count is: {avl.count()}")
        elif choice == '6':
            print("Exiting program.")
            break
        else:
            print("Invalid choice, try again.")
        input("\nPress Enter to continue...")

if __name__ == "__main__":
    main()